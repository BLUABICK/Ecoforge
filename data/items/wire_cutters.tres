[resource]
script = ExtResource("1")
id = &"wire_cutters"
display_name = "Универсальный секатор"
stack_limit = 1
is_tool = true
icon = ExtResource("2_icon")
description = "Ctrl + ЛКМ с перетаскиванием — выделить область срезания. Обычный ЛКМ — одиночный срез. Дальность — 128 пикселей; дальние участки удаляются при приближении. ПКМ — отменить выделение. X + ЛКМ — точный срез."
